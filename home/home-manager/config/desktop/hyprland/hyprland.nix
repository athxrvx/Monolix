{ lib, pkgs, ... }:
let
  root = ./.;
  # The Kuro config is static. kuro.lua is generated by kurogen and is never
  # owned here.
  files = lib.filter
    (p: ! lib.hasSuffix "hyprland.nix" (toString p))
    (lib.filesystem.listFilesRecursive root);
  relative = p: lib.removePrefix (toString root + "/") (toString p);
in
{
  home.packages = with pkgs; [
    hyprsunset
    hyprpicker
    cliphist
    wl-clipboard
    playerctl
    brightnessctl
    grim
    slurp
  ];

  home.file = lib.listToAttrs (map (p: {
    name = ".config/hypr/${relative p}";
    value.source = p;
  }) files);

  home.sessionVariables = {
    TERMINAL = "kitty";
    NIXOS_OZONE_WL = "1";
  };
}
