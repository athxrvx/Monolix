// Athena: Niri scrollable tiling desktop.
// Monolix is the Caelestia-derived Quickshell desktop shell, installed by
// Home Manager. Niri keybinds control its panels through Quickshell IPC.

prefer-no-csd

input {
    mod-key "Alt"
    keyboard {
        xkb { layout "us"; }
    }
    touchpad {
        tap              // tap to click
        dwt              // disable touchpad while typing
        natural-scroll
    }
}

layout {
    gaps 8
    focus-ring {
        active-color "@STYLIX_ACTIVE@"
        inactive-color "@STYLIX_INACTIVE@"
    }
    center-focused-column "never"
    preset-column-widths {
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }
    default-column-width { proportion 0.5; }
}

window-rule {
    geometry-corner-radius 15
    clip-to-geometry true
}

// Keep the Monolix companion apps as centered floating windows, like Settings.
// Niri centers newly opened floating windows by default.
window-rule {
    match title="^Music$"
    open-floating true
}

window-rule {
    match title="^Monohub$"
    open-floating true
}

// Reuse Monolix's pre-blurred wallpaper as Niri's overview backdrop.
layer-rule {
    match namespace="^quickshell:Backdrop$"
    place-within-backdrop true
}

overview {
    backdrop-color "@STYLIX_BACKGROUND@"
}

hotkey-overlay {
    skip-at-startup
}

// Start Monolix through its user service after Niri has established the
// graphical session. The helper imports Niri's live Wayland environment first.
spawn-at-startup "@MONOLIX_START@"

binds {
    // Apps
    Mod+Shift+Return { spawn "@KITTY@"; }
    Mod+Return { spawn "@KITTY@"; }
    Mod+Shift+W { spawn "@MONOLIX@" "ipc" "call" "webApps" "toggleCreator"; }
    Mod+Space { spawn "@MONOLIX@" "ipc" "call" "drawers" "toggle" "launcher"; }
    Mod+S { spawn "@MONOLIX@" "ipc" "call" "controlCenter" "open"; }
    Mod+Shift+Space { spawn "@MONOLIX@" "ipc" "call" "quicktoggles" "toggle"; }
    Mod+V { spawn "@MONOLIX@" "ipc" "call" "clipboard" "toggle"; }
    Mod+Shift+S { spawn "@MONOLIX@" "ipc" "call" "picker" "open"; }
    Ctrl+Mod+Delete { spawn "@MONOLIX@" "ipc" "call" "drawers" "toggle" "session"; }
    Mod+Tab { toggle-overview; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    Mod+W { toggle-window-floating; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Focus and move around the scrollable layout
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Ctrl+Left { set-column-width "-10%"; }
    Mod+Ctrl+Right { set-column-width "+10%"; }
    Mod+Ctrl+Up { set-window-height "+10%"; }
    Mod+Ctrl+Down { set-window-height "-10%"; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    // Workspaces
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Laptop controls
    XF86AudioRaiseVolume allow-when-locked=true { spawn "@WPCTL@" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "@WPCTL@" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "@WPCTL@" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioPlay { spawn "@PLAYERCTL@" "play-pause"; }
    XF86AudioNext { spawn "@PLAYERCTL@" "next"; }
    XF86AudioPrev { spawn "@PLAYERCTL@" "previous"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "@BRIGHTNESSCTL@" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "@BRIGHTNESSCTL@" "set" "5%-"; }
    Mod+Ctrl+L { spawn "@MONOLIX@" "ipc" "call" "lock" "lock"; }
    Print { screenshot; }
}
