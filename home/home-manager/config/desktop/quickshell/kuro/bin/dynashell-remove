#!/usr/bin/env bash
# Remove a package from the persistent dynashell environment.
set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dynashell"
PACKAGES="$STATE_DIR/packages"
mkdir -p "$STATE_DIR"
touch "$PACKAGES"

mapfile -t pkgs < "$PACKAGES"
if ((${#pkgs[@]} == 0)); then
    echo "dynashell has no packages."
    exit 0
fi

finder="${FZPAC_FINDER:-}"
if [[ -z "$finder" ]] || ! command -v "$finder" >/dev/null 2>&1; then
    if command -v fzf >/dev/null 2>&1; then finder="fzf"; else finder=""; fi
fi

if [[ -n "$finder" ]]; then
    choice=$(printf '%s\n' "${pkgs[@]}" | "$finder" --prompt 'Remove from dynashell> ') || exit 0
else
    printf '%s\n' "${pkgs[@]}" | nl -ba
    read -rp 'Number to remove: ' num
    [[ "$num" =~ ^[0-9]+$ ]] || { echo "invalid selection" >&2; exit 1; }
    choice="${pkgs[$((num - 1))]}"
fi

tmp=$(mktemp)
grep -vxF "$choice" "$PACKAGES" > "$tmp" || true
mv "$tmp" "$PACKAGES"
echo "removed from dynashell: $choice"
