#!/usr/bin/env bash
# Open a validated distrobox container in the interactive popup terminal.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/notify.sh"

die() {
    notify_error "Container failed" "$1"
    echo "$1" >&2
    exit "${2:-1}"
}

[[ $# == 1 ]] || die 'Usage: ai-container-open <container>' 2
name=$1
[[ $name =~ ^[a-z][a-z0-9_.-]{0,62}$ ]] || die 'Invalid container name' 2
for tool in podman distrobox; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is unavailable" 127
done
podman container exists "$name" || die "Unknown container: $name"

notify normal "Opening container" "$name"
status=0
distrobox enter "$name" || status=$?
if (( status == 0 )); then
    notify_ok "Container session ended" "$name"
else
    notify_error "Container failed" "$name exited with status $status."
fi
exit "$status"
