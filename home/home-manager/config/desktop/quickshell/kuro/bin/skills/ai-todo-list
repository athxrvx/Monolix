#!/usr/bin/env bash
# Read-only: list open tasks from the Markdown file owned by Todos.qml.
set -euo pipefail

file="${HOME:?}/Documents/Tasks/Todo.md"
if [[ ! -f $file ]]; then
    echo "No task file exists at $file."
    exit 0
fi

mapfile -t all < <(
    awk '
        /^[[:space:]]*-[[:space:]]+\[[ xX]\][[:space:]]+[0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]+\|/ {
            if ($0 ~ /\[[xX]\]/) next
            line = $0
            sub(/^[[:space:]]*-[[:space:]]+\[[ xX]\][[:space:]]+/, "", line)
            date = substr(line, 1, 10)
            title = substr(line, 14)
            printf "%s\t%s\n", date, title
        }' "$file" | sort
)

if (( ${#all[@]} == 0 )); then
    echo "No open tasks."
    exit 0
fi

printf 'Open tasks (%d):\n' "${#all[@]}"
for line in "${all[@]:0:40}"; do
    printf '  %s\n' "${line//$'\t'/  }"
done
if (( ${#all[@]} > 40 )); then
    printf '  … %d more\n' "$(( ${#all[@]} - 40 ))"
fi
