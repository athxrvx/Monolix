#!/bin/sh
set -eu

prompt="${2:-${1:-Select}}"
runtime="${XDG_RUNTIME_DIR:-/tmp}"
request_dir=$(mktemp -d "$runtime/kuro-anime-menu.XXXXXX")
input_file="$request_dir/options"
result_file="$request_dir/result"
cat > "$input_file"
if ! qs -c shell ipc call sidebar animeMenu "$prompt" "$input_file" "$result_file" >/dev/null 2>&1; then
    rm -rf "$request_dir"
    exit 1
fi
attempt=0
while [ ! -f "$result_file" ]; do
    if [ "$attempt" -ge 36000 ]; then
        rm -rf "$request_dir"
        exit 1
    fi
    sleep 0.1
    attempt=$((attempt + 1))
done
cat "$result_file"
rm -rf "$request_dir"
