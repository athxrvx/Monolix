#!/usr/bin/env sh
:; # -*- mode: emacs-lisp; lexical-binding: t -*-
:; # Bobamacs CLI - Doom-inspired CLI for Bobamacs
:; case "$EMACS" in *term*) EMACS=emacs ;; *) EMACS="${EMACS:-emacs}" ;; esac
:; [ "x$EMACS" = xemacs ] && { type emacs >/dev/null 2>&1 || err=1; }
:; [ "x$err" = x ] || { echo "Error: failed to run Emacs with command '$EMACS'"; echo; echo "Are you sure Emacs is installed and in your \$PATH?"; exit 1; } >&2
:; emacs="$EMACS ${DEBUG:+--debug-init} -q --no-site-file --batch"
:; export EMACS_PLUS_NO_PATH_INJECTION=1
:; export __BOBAPID="${__BOBAPID:-$$}"
:; export __BOBASTEP="${__BOBASTEP:-0}"
:; export __BOBAGEOM="${__BOBAGEOM:-`tput cols 2>/dev/null`x`tput lines 2>/dev/null`}"
:; export __BOBAGPIPE=${__BOBAGPIPE:-$__BOBAPipe}
:; export __BOBAPipe=; [ -t 0 ] || __BOBAPipe="${__BOBAPipe}0"; [ -t 1 ] || __BOBAPipe="${__BOBAPipe}1"
:; eval "$emacs --eval \"(setq warning-inhibit-types '((files missing-lexbind-cookie)))\" --load \"$0\"" -- "$@" || exit=$?
:; [ "${exit:-0}" -eq 254 ] && { export TMPDIR="${TMPDIR:-${TMP:-${TEMP:-`eval "$emacs -Q --eval '(princ temporary-file-directory)'" 2>/dev/null`}}}"; sh "${TMPDIR}/boba.${__BOBAPID}.${__BOBASTEP}.sh" "$0" "$@" && true; exit="$?"; }
:; exit $exit

;; This shebang allows the file to be both a shell script and Elisp.
;; The :; hack exploits shell/elisp differences:
;; - In shell, ":" is a no-op command, ";" separates commands
;; - In elisp, ":" is a keyword symbol, ";" starts a comment

;; Bobamacs core paths
(defvar boba-emacs-dir
  (or (getenv "EMACSDIR")
      (expand-file-name "~/.config/emacs"))
  "Bobamacs installation directory.")

(defvar boba-config-dir
  (or (getenv "BOBADIR")
      (expand-file-name "boba" (or (getenv "XDG_CONFIG_HOME") "~/.config")))
  "User configuration directory (~/.config/boba).")

(defvar boba-data-dir
  (expand-file-name "boba" (or (getenv "XDG_DATA_HOME") "~/.local/share"))
  "Data directory (~/.local/share/boba).")

;; Load early-init.el which sets up package.el and straight.el
(condition-case e
    (let* ((bin-dir (file-name-directory (file-truename load-file-name)))
           (init-file (expand-file-name "../early-init.el" bin-dir)))
      (or (and (load init-file nil 'nomessage 'nosuffix)
               (featurep 'early-init))
          (user-error "Failed to load Bobamacs from %s" init-file)))
  (error (message "Error: %s" (cadr e))
         (kill-emacs 2)))

;; Add emacs directory to load-path so straight.el can be found
(add-to-list 'load-path (expand-file-name "straight/repos/straight.el" user-emacs-directory))

;; CLI framework
(require 'cl-lib)
(require 'subr-x)

;; Pretty printing
(defun boba-print (level msg &rest args)
  (let ((fmt (apply 'format msg args)))
    (cond
     ((eq level 'error) (message "\033[0;31m[ERROR]\033[0m %s" fmt))
     ((eq level 'warn)  (message "\033[1;33m[WARN]\033[0m %s" fmt))
     ((eq level 'info)  (message "\033[0;34m[INFO]\033[0m %s" fmt))
     ((eq level 'ok)    (message "\033[0;32m[OK]\033[0m %s" fmt))
     (t (message "%s" fmt)))))

;; Simple CLI parsing
(defun boba-cli-parse-args (args)
  (let ((cmd (car args))
        (rest (cdr args))
        (opts '()))
    (while rest
      (pcase (car rest)
        (`("--force" . _) (setq boba-force t) (setq rest (cdr rest)))
        (`("--debug" . _) (setq boba-debug t) (setq rest (cdr rest)))
        (`("--verbose" . _) (setq boba-verbose t) (setq rest (cdr rest)))
        (`("--emacsdir" . val) (setenv "EMACSDIR" val) (setq rest (cddr rest)))
        (`("--bobadir" . val) (setenv "BOBADIR" val) (setq rest (cddr rest)))
        (_ (push (car rest) opts) (setq rest (cdr rest))))
      )
    (list cmd (nreverse opts))))

;; Bootstrap straight.el
(defun boba-bootstrap-straight ()
  (boba-print 'info "Bootstrapping straight.el...")
  (let ((bootstrap-file
         (expand-file-name "straight/repos/straight.el/bootstrap.el" user-emacs-directory)))
    (unless (file-exists-p bootstrap-file)
      (with-current-buffer
          (url-retrieve-synchronously
           "https://raw.githubusercontent.com/radian-software/straight.el/develop/install.el"
           'silent 'inhibit-cookies)
        (goto-char (point-min))
        (re-search-forward "^$" nil t)
        (eval-region (point) (point-max))))
    (load bootstrap-file nil 'nomessage))
  (boba-print 'ok "straight.el bootstrapped"))

;; Install packages
(defun boba-install-packages ()
  (boba-print 'info "Installing packages...")
  (require 'straight)
  (straight-use-package 'use-package)
  (setq straight-use-package-by-default t)
  (straight-use-package '(org :type built-in))
  (boba-print 'ok "Packages installed"))

;; Update packages
(defun boba-update-packages ()
  (boba-print 'info "Updating packages...")
  (require 'straight)
  (straight-fetch-all)
  (straight-rebuild-all)
  (boba-print 'ok "Packages updated"))

;; Pull config from git
(defun boba-pull-config ()
  (boba-print 'info "Pulling latest config from repo...")
  (if (and (file-directory-p (expand-file-name ".git" boba-emacs-dir))
           (not (string= "" (shell-command-to-string (format "git -C %s remote" boba-emacs-dir)))))
      (progn
        (shell-command (format "git -C %s pull" boba-emacs-dir))
        (boba-print 'ok "Config repository updated"))
    (boba-print 'warn "Not a git repository or no remote, skipping pull")))

;; Main commands
(defun boba-cmd-install ()
  (boba-print 'info "Installing Bobamacs...")
  (boba-print 'info "Found Emacs %s" (substring emacs-version 0 (string-match " " emacs-version)))
  (let ((dirs (list boba-config-dir boba-data-dir)))
    (dolist (dir dirs)
      (unless (file-directory-p dir)
        (make-directory dir t)))
    (boba-print 'ok "Directories created"))
  (unless (file-exists-p (expand-file-name "config.el" boba-config-dir))
    (copy-file (expand-file-name "config.el.example" boba-emacs-dir)
               (expand-file-name "config.el" boba-config-dir) t)
    (boba-print 'ok "Created ~/.config/boba/config.el"))
  (boba-bootstrap-straight)
  (boba-install-packages)
  (boba-print 'ok "Bobamacs installed! Run 'emacs' to start."))

(defun boba-cmd-update ()
  (boba-print 'info "Updating Bobamacs...")
  (boba-pull-config)
  (boba-update-packages)
  (boba-print 'ok "Bobamacs updated!"))

(defun boba-cmd-bootstrap ()
  (boba-print 'info "Re-bootstrapping straight.el...")
  (when (file-exists-p (expand-file-name "straight/repos/straight.el" user-emacs-directory))
    (delete-directory (expand-file-name "straight/repos/straight.el" user-emacs-directory) t))
  (boba-bootstrap-straight)
  (boba-install-packages)
  (boba-print 'ok "Re-bootstrap complete"))

(defun boba-cmd-doctor ()
  (boba-print 'info "Running diagnostics...")
  (let ((issues '()))
    (unless (executable-find "emacs")
      (push "Emacs not found in PATH" issues))
    (unless (file-directory-p boba-emacs-dir)
      (push (format "Emacs dir not found: %s" boba-emacs-dir) issues))
    (unless (file-directory-p boba-config-dir)
      (push (format "Config dir not found: %s" boba-config-dir) issues))
    (unless (file-exists-p (expand-file-name "early-init.el" boba-emacs-dir))
      (push "early-init.el not found" issues))
    (if issues
        (progn
          (boba-print 'error "Found issues:")
          (dolist (i issues) (boba-print 'error "  - %s" i)))
      (boba-print 'ok "All checks passed"))))

(defun boba-cmd-emacs ()
  "Launch Emacs with Bobamacs configuration."
  (let ((emacs-bin (or (getenv "EMACS") "emacs")))
    (if (display-graphic-p)
        ;; Interactive: replace this process with Emacs
        (apply #'execv emacs-bin (append (list emacs-bin) (cdr (member "--" argv))))
      ;; Batch/TTY: use call-process
      (apply #'call-process emacs-bin nil nil nil
             (append (list emacs-bin) (cdr (member "--" argv)))))))

;; Main entry
(defun boba-main ()
  (let* ((args (cdr (member "--" argv)))
         (parsed (boba-cli-parse-args args))
         (cmd (car parsed))
         (opts (cadr parsed)))
    (pcase cmd
      ("install" (boba-cmd-install))
      ("update"  (boba-cmd-update))
      ("bootstrap" (boba-cmd-bootstrap))
      ("doctor"  (boba-cmd-doctor))
      ("emacs"   (boba-cmd-emacs))
      ("help"    (boba-print 'info "Usage: boba {install|update|bootstrap|doctor|emacs|help}"))
      (_         (boba-print 'error "Unknown command: %s" (or cmd ""))
                (boba-print 'info "Usage: boba {install|update|bootstrap|doctor|emacs|help}")))))

;; Run
(boba-main)

;;;; boba ends here