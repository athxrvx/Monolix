{ config, lib, pkgs, ... }:
{
  imports = [
    ./hardware-configuration.nix   # generated by nixos-generate-config; do not edit
    ../../modules/security/blacklist.nix
    ../../modules/audio/audio.nix
    ../../modules/bluetooth/bluetooth.nix
    ../../modules/security/security.nix
    ../../modules/services/services.nix
    ../../modules/system/network.nix
    ../../modules/optimizations/optimize.nix
    ../../modules/power/laptop.nix
  ];

  services.flatpak.enable = true;

  # Locale, keymap and time (from the fresh install).
  i18n.defaultLocale = "en_IN";
  i18n.extraLocaleSettings = {
    LC_ADDRESS = "en_IN";
    LC_IDENTIFICATION = "en_IN";
    LC_MEASUREMENT = "en_IN";
    LC_MONETARY = "en_IN";
    LC_NAME = "en_IN";
    LC_NUMERIC = "en_IN";
    LC_PAPER = "en_IN";
    LC_TELEPHONE = "en_IN";
    LC_TIME = "en_IN";
  };
  console = {
    font = "Lat2-Terminus16";
    keyMap = "us";
  };
  services.xserver.xkb = {
    layout = "us";
    variant = "";
  };
  time.timeZone = "Asia/Kolkata";

  # Lanzaboote signs boot entries with keys managed by sbctl.
  athena.secureboot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
  boot.kernelPackages = pkgs.linuxPackages_latest;
  # Use the existing swap partition to resume hibernated sessions.
  boot.resumeDevice = "/dev/disk/by-uuid/47fc9569-298a-4466-b8e2-dfebf3c7b72c";
  # Fallback boot entry on the stable kernel, for when a new kernel breaks
  # the NVIDIA module. Pick "lts" in the boot menu.
  specialisation.lts.configuration = {
    boot.kernelPackages = lib.mkForce pkgs.linuxPackages;
  };
  boot.plymouth.enable = true;
  boot.consoleLogLevel = 0;
  boot.kernelParams = [ "quiet" "udev.log_priority=3" ];

  # HP Victus 15-fb2117ax: Ryzen 7 8845HS, Radeon 780M and RTX 4050.
  # (CPU microcode comes from hardware-configuration.nix.)
  hardware.enableRedistributableFirmware = true;
  hardware.graphics = {
    enable = true;
    enable32Bit = true;
  };
  services.xserver.videoDrivers = [ "amdgpu" "nvidia" ];
  hardware.nvidia = {
    modesetting.enable = true;
    open = true;
    nvidiaSettings = true;
    powerManagement.enable = true;
    dynamicBoost.enable = true;
    # Hybrid graphics: the Radeon 780M (06:00.0) drives the display and the
    # RTX 4050 (01:00.0) is used on demand with `nvidia-offload <app>`.
    prime = {
      offload.enable = true;
      offload.enableOffloadCmd = true;
      amdgpuBusId = "PCI:6:0:0";
      nvidiaBusId = "PCI:1:0:0";
    };
    powerManagement.finegrained = true;
  };

  services.printing.enable = true;
  # KDE Connect needs its discovery and device-communication ports open.
  programs.kdeconnect.enable = true;
  # uBlock Origin Lite policy: full filtering plus privacy and nuisance lists.
  programs.chromium = {
    enable = true;
    extraOpts."3rdparty".extensions."ddkjiahejlhfcafbddmgiahcphecmpfh" = {
      defaultFiltering = "complete";
      rulesets = [
        "+default"
        "+adguard-spyware-url"
        "+annoyances-cookies"
        "+annoyances-overlays"
        "+annoyances-social"
        "+annoyances-widgets"
        "+annoyances-others"
        "+annoyances-notifications"
      ];
    };
  };
  environment.systemPackages = with pkgs; [
    android-tools
    papirus-icon-theme
    bibata-cursors
  ];
  environment.sessionVariables = {
    XCURSOR_THEME = "Bibata-Modern-Ice";
    XCURSOR_SIZE = "20";
  };

  system.stateVersion = "26.05";
  documentation.nixos.enable = false;
  xdg.portal = {
    enable = true;
    extraPortals = [ pkgs.xdg-desktop-portal-gnome ];
    config.common.default = [ "gnome" ];
  };
  nixpkgs.config.allowUnfree = true;
  # Keep Qt plugin discovery enabled, without selecting a separate Qt theme UI.
  qt.enable = true;
  nix = {
    package = pkgs.nix;
    settings = {
      experimental-features = [ "nix-command" "flakes" ];
      substituters = [ "https://nix-community.cachix.org" ];
      trusted-public-keys = [
        "nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs="
      ];
    };
  };
}
