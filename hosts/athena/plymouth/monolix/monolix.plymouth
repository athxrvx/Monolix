[Plymouth Theme]
Name=Monolix
Description=Omarchy-inspired Monolix near-black slate splash.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/monolix
ScriptFile=/usr/share/plymouth/themes/monolix/monolix.script
ConsoleLogBackgroundColor=0x0c0e0f
MonospaceFont=Cantarell 9
Font=Cantarell 9
